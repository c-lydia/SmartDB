{
  "name": "smartdb-system",
  "private": true,
  "workspaces": [
    "cloud",
    "dashboard"
  ],
  "scripts": {
    "format": "sh tools/format.sh --write",
    "format:check": "sh tools/format.sh --check",
    "build": "npm run build --workspace dashboard",
    "start": "npm run build && node tools/system.mjs",
    "test": "firebase emulators:exec --project demo-smartdb --only auth,firestore 'npm test --workspace cloud'",
    "seed": "node cloud/scripts/bootstrap.mjs"
  },
  "devDependencies": {
    "firebase-tools": "15.33.0",
    "prettier": "3.9.6"
  }
}
