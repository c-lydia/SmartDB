# Secure is the production default and fails closed without a supported DTLS runtime.
SMARTDB_TRANSPORT_MODE=secure
SMARTDB_HOST=0.0.0.0
SMARTDB_PORT=5687
SMARTDB_MAX_PAYLOAD_BYTES=1024
SMARTDB_DATABASE_PATH=./data/ingestion.sqlite3
SMARTDB_RATE_LIMIT_PER_MINUTE=120
SMARTDB_REPLAY_WINDOW_SIZE=1024
SMARTDB_CONFIG_PATH=./config/device-config.cbor
SMARTDB_CONFIG_KEY_ID=cfg-2026-01
# Secret JSON file outside source control: {"db-001":"32-or-more-hex-characters"}
SMARTDB_DTLS_PSK_FILE=/run/secrets/smartdb-dtls-psks.json
